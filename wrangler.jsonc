{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // gamedev.trebeljahr.com: the static export in showcase/out, served by Cloudflare
  // Workers static assets. Build with `pnpm build`; deploys run in
  // .github/workflows/deploy.yml (`wrangler versions upload`, then
  // `wrangler versions deploy`).
  "name": "gamedev",
  "compatibility_date": "2026-09-30",
  // Assets only. No `main`: with no Worker script every request is an asset
  // request, which does not count toward the Workers Free request limit. Do
  // not add `main`, `run_worker_first` or `cache` without reading
  // docs/cloudflare-hosting.md.
  // No `routes`: the zone route `gamedev.trebeljahr.com/*` is made through
  // the API, and a deploy leaves API-made routes alone only while this key
  // is absent.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./showcase/out",
    // /kaykit serves kaykit.html; /kaykit/ redirects to /kaykit.
    "html_handling": "auto-trailing-slash",
    // Unknown paths answer 404 with out/404.html.
    "not_found_handling": "404-page"
  }
}
