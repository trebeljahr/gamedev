# gamedev — local override template (copy → .env.local, never commit)
#
# .env.local is layered on top of .env.production by `pnpm assets:sync`
# (via dotenvx). Use it for per-machine overrides — typically just
# pointing the showcase at the local asset HTTP server during dev.

# Point the showcase at the local asset HTTP server (scripts/serve-assets.mjs)
# so you don't burn R2 egress / Cloudflare bandwidth while iterating.
NEXT_PUBLIC_ASSETS_BASE_URL=http://localhost:9101

# Optional: override the asset HTTP server port (default 9101).
# ASSETS_PORT=9101
