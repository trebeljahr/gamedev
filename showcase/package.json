{
  "name": "3d-assets-showcase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "catalog:check": "node scripts/check-generated-catalogs.mjs",
    "catalog:refresh": "tsx scripts/build-manifest.ts && tsx scripts/build-audio-analysis.ts && tsx scripts/build-media-catalog.ts",
    "manifest": "pnpm catalog:refresh",
    "media:assets": "tsx scripts/build-media-assets.ts",
    "media:audio": "tsx scripts/build-audio-analysis.ts",
    "media:catalog": "tsx scripts/build-media-assets.ts && tsx scripts/build-audio-analysis.ts && tsx scripts/build-media-catalog.ts",
    "manifest:enrich": "tsx scripts/enrich-existing-manifest.ts",
    "predev": "node scripts/check-generated-catalogs.mjs",
    "prebuild": "node scripts/check-generated-catalogs.mjs",
    "dev": "next dev --turbopack --port 3679",
    "build": "next build",
    "start": "next start --port 3679",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hatchkit/dev-plugin-next": "^0.2.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "case": "^1.6.3",
    "fflate": "^0.8.2",
    "joystick-controller": "^2.0.0",
    "leva": "^0.10.1",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "draco3d": "^1.5.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
