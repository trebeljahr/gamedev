# gamedev — runtime env (template)
#
# Two real files derive from this:
#
#   .env.production   committed, ENCRYPTED via dotenvx.
#                     `hatchkit adopt` generates this (and .env.keys) and
#                     uploads the private key to Coolify / the OS keychain
#                     under service "hatchkit". After that, edits go through
#                     `dotenvx set FOO=bar -f .env.production`.
#
#   .env.local        per-machine, gitignored, plaintext. Use it to override
#                     anything from .env.production locally (e.g. point at a
#                     local MinIO instead of prod R2). Layered ON TOP of
#                     .env.production by `pnpm assets:sync`.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the showcase bundle at
# build time, so it ships to the browser. Don't put secrets in those.

# --- Asset origin --------------------------------------------------------
# The showcase fetches GLBs/textures/etc. from this base URL.
#   dev    → http://localhost:9101         (scripts/serve-assets.mjs)
#   prod   → https://assets.gamedev.trebeljahr.com   (R2 custom domain)
NEXT_PUBLIC_ASSETS_BASE_URL=https://assets.gamedev.trebeljahr.com

# --- R2 sync credentials (used by `pnpm assets:sync`) --------------------
# Generate the API token at https://dash.cloudflare.com → R2 → Manage API
# Tokens. Grant Object Read & Write on the assets bucket only.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET=gamedev-assets
