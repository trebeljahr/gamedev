{
  "name": "3d-assets",
  "private": true,
  "description": "Local 3d-assets library. The showcase web app lives under showcase/ and is wired up here as a pnpm workspace so `pnpm install` and `pnpm dev` from the repo root just work.",
  "scripts": {
    "dev": "pnpm --filter 3d-assets-showcase dev",
    "build": "pnpm --filter 3d-assets-showcase build",
    "start": "pnpm --filter 3d-assets-showcase start",
    "lint": "pnpm --filter 3d-assets-showcase lint",
    "manifest": "pnpm --filter 3d-assets-showcase manifest"
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38"
}
